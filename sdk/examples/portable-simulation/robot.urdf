<?xml version="1.0"?>
<robot name="waddle_portable_demo_arm">
  <link name="base">
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual><geometry><cylinder radius="0.10" length="0.12"/></geometry></visual>
    <collision><geometry><cylinder radius="0.10" length="0.12"/></geometry></collision>
  </link>
  <link name="upper_arm">
    <inertial>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.012" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.40"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.40"/></geometry>
    </collision>
  </link>
  <link name="forearm">
    <inertial>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.0015"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.36"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.36"/></geometry>
    </collision>
  </link>
  <link name="tool"/>
  <joint name="shoulder" type="revolute">
    <parent link="base"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.4" upper="1.4" velocity="1.5" effort="12"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0 0 0.40" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.8" upper="1.8" velocity="1.8" effort="8"/>
  </joint>
  <joint name="tool_fixed" type="fixed">
    <parent link="forearm"/>
    <child link="tool"/>
    <origin xyz="0 0 0.36" rpy="0 0 0"/>
  </joint>
</robot>
