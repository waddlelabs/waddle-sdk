from __future__ import annotations

from dataclasses import replace

import numpy as np
import pytest

from waddle_sdk.robots.site import PartConfig

from __PACKAGE_NAME__ import backend

TEST_POSITION = tuple((lower + upper) * 0.5 for lower, upper in backend.LIMITS)


class FakeVendor:
    def __init__(self) -> None:
        # Test-only state for the fake bus; this is not a hardware home fact.
        self.position = np.asarray(TEST_POSITION, dtype=float)
        self.writes = []
        self.held = self.stopped = self.enabled = self.closed = 0

    def read(self):
        return self.position.copy(), np.zeros_like(self.position)

    def write(self, target):
        self.writes.append(tuple(target))

    def hold(self):
        self.held += 1

    def estop(self):
        self.stopped += 1

    def re_enable(self):
        self.enabled += 1

    def close(self):
        self.closed += 1


def config() -> PartConfig:
    return PartConfig(
        name="arm",
        posture="monitor",
        connection={},
        joint_limits=dict(zip(backend.JOINTS, backend.LIMITS, strict=True)),
        workspace_bounds={},
        envelope={},
    )


def test_factory_is_lazy_and_driver_latches_estop(monkeypatch):
    assert backend.FACTS_SOURCE == __FACTS_SOURCE__
    fake = FakeVendor()
    opened = []
    monkeypatch.setattr(backend, "_open_vendor", lambda _config: opened.append(1) or fake)
    rig = backend.arm(config=config())
    assert opened == []
    driver = rig.arms()[""].driver
    assert opened == [1]
    driver.estop()
    driver.write(np.asarray(TEST_POSITION))
    assert fake.writes == []
    driver.re_enable()
    driver.write(np.asarray(TEST_POSITION))
    assert fake.writes == [TEST_POSITION]
    driver.close()
    driver.close()
    assert fake.closed == 1


def test_arm_validation_failure_closes_the_opened_vendor(monkeypatch):
    fake = FakeVendor()
    monkeypatch.setattr(backend, "_open_vendor", lambda _config: fake)

    def refuse_arm(**_kwargs):
        raise ValueError("invalid arm facts")

    monkeypatch.setattr(backend.base, "Arm", refuse_arm)
    with pytest.raises(ValueError, match="invalid arm facts"):
        backend.arm(config=config()).arms()
    assert fake.closed == 1


def test_workspace_rule_fails_closed_until_fk_is_implemented():
    workspace = {"min": [-0.1, -0.1, 0.0], "max": [0.1, 0.1, 0.2]}
    with pytest.raises(ValueError, match="frame-correct FK"):
        backend.arm(config=replace(config(), workspace_bounds=workspace))
