{
  "format": "waddle.behavior/v0",
  "name": "retake_skips_post_reset",
  "description": "Pins FSM.md E18: retake BYPASSES post-reset entirely, even on a predecessor that declared one — retake is exactly E9/C5 (the claim survives, release_claim=false), so it never routes through request_terminal/E14. From INTERVENTION SETTLE, retake must terminate the predecessor with TERMINAL_OUTCOME_ABORTED_RETAKE directly (never EPISODE_STATE_POST_RESET) and emit the open_successor effect carrying the still-held claim; the successor opens under that claim in RESETTING, not having inherited the predecessor's post-reset declaration (post-reset is per-episode, requested explicitly on each episode_open).",
  "target": "fsm",
  "requires_features": ["waddle.v0.core", "waddle.v0.reset.phases"],
  "setup": {
    "lease_enforcement": "LEASE_ENFORCEMENT_ENFORCED",
    "handoff": { "immediate": { "blendNs": "0" } },
    "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING"
  },
  "steps": [
    { "inject": { "kind": "episode_open", "episode_id": "ep-rsp-0001", "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING", "post_reset": true } },
    { "advance_ns": "100000000" },
    { "inject": { "kind": "reset_result", "result": { "ok": true, "strategy": "scripted_home", "verification": { "mode": "RESET_VERIFICATION_MODE_BLOCKING", "verified": true, "judgeId": "judge-reset", "judgeVersion": "2.1.0", "score": 0.96, "tNs": "100000000" } } } },
    { "inject": { "kind": "start" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_RUNNING" } },

    { "advance_ns": "100000000" },
    { "inject": { "kind": "claim_granted", "claim": { "claimId": "claim-rsp-0001", "episodeId": "ep-rsp-0001", "actor": { "kind": "ACTOR_KIND_TELEOPERATOR", "id": "top-7", "displayName": "Teleoperator 7" }, "sourceName": "teleop", "selfInitiated": false, "tGrantedNs": "200000000", "handoff": { "immediate": { "blendNs": "0" } }, "spaces": ["SPACE_KIND_EE_POSE_DELTA"] } } },
    { "inject": { "kind": "engage", "claim_id": "claim-rsp-0001", "initiator": "ACTOR_KIND_TELEOPERATOR" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_INTERVENTION" } },
    { "advance_ns": "300000000" },
    { "expect_state": { "episode.intervention_phase": "INTERVENTION_PHASE_SETTLE" } },

    { "inject": { "kind": "retake", "claim_id": "claim-rsp-0001", "initiator": "ACTOR_KIND_TELEOPERATOR", "successor_episode_id": "ep-rsp-0002" } },
    { "expect_no_emission": { "event": { "state": { "to": "EPISODE_STATE_POST_RESET" } }, "within_ns": "0" } },
    { "expect_emission": { "event": { "state": { "to": "EPISODE_STATE_TERMINAL", "outcome": "TERMINAL_OUTCOME_ABORTED_RETAKE" } }, "within_ns": "0" } },
    { "expect_emission": { "effect": { "open_successor": { "predecessor_episode_id": "ep-rsp-0001", "claim_id": "$active_claim", "born_claimed": true, "verification_mode": "RESET_VERIFICATION_MODE_OPTIMISTIC_ASYNC" } }, "within_ns": "0" } },
    { "expect_state": { "episode.id": "ep-rsp-0002", "episode.state": "EPISODE_STATE_RESETTING", "episode.born_claimed": true, "episode.parent_episode_id": "ep-rsp-0001", "episode.post_reset_declared": false, "claim.active_claim_id": "$active_claim" } }
  ]
}
