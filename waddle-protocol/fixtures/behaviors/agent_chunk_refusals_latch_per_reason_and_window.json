{
  "format": "waddle.behavior/v0",
  "name": "agent_chunk_refusals_latch_per_reason_and_window",
  "description": "Pins how often a GateServerMessage.intervention_chunk sender is told it was refused: at most once per REASON per CLAIM WINDOW. The three refusals say different things — a width that doesn't fit the addressed part, a name the declaration doesn't have, and steps that carry nothing to dispatch — so each is owed once even though a sender making one mistake usually makes it repeatedly: within one window the first chunk of each shape raises exactly one Fault{FAULT_KIND_VALIDATION_ERROR} and the second of the same shape raises none, while a chunk of a DIFFERENT shape still raises its own. The latch is keyed to the claim window's identity, not to any holder noticing a window close: after the claim releases and a second claimant engages, the same width mistake is reported again — the successor never sent the first chunk and is owed the answer to its own. Every caller tick throughout returns hold: a refused chunk dispatches nothing. Judgment calls: Fault.source is implementation-named (control.proto), so it is asserted as $nonempty; the reasons ride the same FAULT_KIND_VALIDATION_ERROR, so 'no second fault' is asserted as no fault of any kind in the window; HOLD_FIRST for both claims so neither engage opens a blend window; both claims are ACTOR_KIND_AGENT because this arm is the one a hosted agent streams on; part names, the unknown name 'waist' and the 7-value part width come from the bimanual fixture.",
  "target": "gate",
  "requires_features": ["waddle.v0.core", "waddle.v0.agent", "waddle.v0.parts"],
  "setup": {
    "robot_fixture": "../wire/robot_description_bimanual_composite.json",
    "lease_enforcement": "LEASE_ENFORCEMENT_ENFORCED",
    "handoff": { "holdFirst": {} },
    "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING"
  },
  "steps": [
    { "inject": { "kind": "episode_open", "episode_id": "ep-crl-0001", "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING" } },
    { "advance_ns": "100000000" },
    { "inject": { "kind": "reset_result", "result": { "ok": true, "strategy": "scripted_home", "verification": { "mode": "RESET_VERIFICATION_MODE_BLOCKING", "verified": true, "judgeId": "judge-reset", "judgeVersion": "2.1.0", "score": 0.97, "tNs": "100000000" } } } },
    { "expect_state": { "episode.state": "EPISODE_STATE_READY" } },

    { "advance_ns": "100000000" },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "200000000" } },
    { "expect_output": { "kind": "pass" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_RUNNING", "gate.mode": "GATE_MODE_PASSTHROUGH" } },

    { "inject": { "kind": "claim_granted", "claim": { "claimId": "claim-crl-0001", "episodeId": "ep-crl-0001", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1", "displayName": "Waddle agent" }, "sourceName": "waddle-agent", "selfInitiated": false, "tGrantedNs": "200000000", "handoff": { "holdFirst": {} }, "spaces": ["SPACE_KIND_JOINT_POSITION"] } } },
    { "inject": { "kind": "engage", "claim_id": "claim-crl-0001", "initiator": "ACTOR_KIND_AGENT" } },
    { "advance_ns": "50000000" },
    { "inject": { "kind": "verb_result", "result": { "ok": true, "detail": "hold complete, arms at rest", "tNs": "250000000" } } },
    { "expect_emission": { "event": { "lease": { "kind": "LEASE_EVENT_KIND_HANDED_OFF", "lease": { "leaseId": "$fresh_lease" } } }, "within_ns": "0" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_INTERVENTION", "gate.mode": "GATE_MODE_INTERVENTION" } },

    { "advance_ns": "10000000" },
    { "inject": { "kind": "intervention_chunk", "chunk": { "seq": "1", "sourceId": "agent-waddle-1", "tEmittedNs": "260000000", "tObsNs": "260000000", "horizonNs": "100000000", "provenance": { "kind": "PROVENANCE_KIND_AGENT", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1" } }, "actions": [
      { "tOffsetNs": "0", "part": "left", "jointPosition": { "values": [0.12, -0.38, 0.31, -1.18, 0.06, 0.91] } }
    ] } } },
    { "expect_emission": { "event": { "fault": { "kind": "FAULT_KIND_VALIDATION_ERROR", "source": "$nonempty" } }, "within_ns": "0" } },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "260000000" } },
    { "expect_output": { "kind": "hold" } },

    { "advance_ns": "10000000" },
    { "inject": { "kind": "intervention_chunk", "chunk": { "seq": "2", "sourceId": "agent-waddle-1", "tEmittedNs": "270000000", "tObsNs": "270000000", "horizonNs": "100000000", "provenance": { "kind": "PROVENANCE_KIND_AGENT", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1" } }, "actions": [
      { "tOffsetNs": "0", "part": "left", "jointPosition": { "values": [0.13, -0.37, 0.32, -1.17, 0.07, 0.92] } }
    ] } } },
    { "expect_no_emission": { "event": { "fault": {} }, "within_ns": "0" } },

    { "advance_ns": "10000000" },
    { "inject": { "kind": "intervention_chunk", "chunk": { "seq": "3", "sourceId": "agent-waddle-1", "tEmittedNs": "280000000", "tObsNs": "280000000", "horizonNs": "100000000", "provenance": { "kind": "PROVENANCE_KIND_AGENT", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1" } }, "actions": [
      { "tOffsetNs": "0", "part": "waist", "jointPosition": { "values": [0.12, -0.38, 0.31, -1.18, 0.06, 0.91, 0.20] } }
    ] } } },
    { "expect_emission": { "event": { "fault": { "kind": "FAULT_KIND_VALIDATION_ERROR", "source": "$nonempty" } }, "within_ns": "0" } },

    { "advance_ns": "10000000" },
    { "inject": { "kind": "intervention_chunk", "chunk": { "seq": "4", "sourceId": "agent-waddle-1", "tEmittedNs": "290000000", "tObsNs": "290000000", "horizonNs": "100000000", "provenance": { "kind": "PROVENANCE_KIND_AGENT", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1" } }, "actions": [
      { "tOffsetNs": "0", "part": "waist", "jointPosition": { "values": [0.13, -0.37, 0.32, -1.17, 0.07, 0.92, 0.21] } }
    ] } } },
    { "expect_no_emission": { "event": { "fault": {} }, "within_ns": "0" } },

    { "advance_ns": "10000000" },
    { "inject": { "kind": "intervention_chunk", "chunk": { "seq": "5", "sourceId": "agent-waddle-1", "tEmittedNs": "300000000", "tObsNs": "300000000", "horizonNs": "100000000", "provenance": { "kind": "PROVENANCE_KIND_AGENT", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1" } }, "actions": [
      { "tOffsetNs": "0", "noop": {} }
    ] } } },
    { "expect_emission": { "event": { "fault": { "kind": "FAULT_KIND_VALIDATION_ERROR", "source": "$nonempty" } }, "within_ns": "0" } },

    { "advance_ns": "10000000" },
    { "inject": { "kind": "intervention_chunk", "chunk": { "seq": "6", "sourceId": "agent-waddle-1", "tEmittedNs": "310000000", "tObsNs": "310000000", "horizonNs": "100000000", "provenance": { "kind": "PROVENANCE_KIND_AGENT", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1" } }, "actions": [
      { "tOffsetNs": "0", "noop": {} }
    ] } } },
    { "expect_no_emission": { "event": { "fault": {} }, "within_ns": "0" } },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "310000000" } },
    { "expect_output": { "kind": "hold" } },

    { "advance_ns": "10000000" },
    { "inject": { "kind": "release", "claim_id": "claim-crl-0001", "initiator": "ACTOR_KIND_AGENT" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_RUNNING", "gate.mode": "GATE_MODE_PASSTHROUGH", "claim.active_claim_id": "" } },

    { "advance_ns": "10000000" },
    { "inject": { "kind": "claim_granted", "claim": { "claimId": "claim-crl-0002", "episodeId": "ep-crl-0001", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-2", "displayName": "Waddle agent (successor)" }, "sourceName": "waddle-agent", "selfInitiated": false, "tGrantedNs": "330000000", "handoff": { "holdFirst": {} }, "spaces": ["SPACE_KIND_JOINT_POSITION"] } } },
    { "inject": { "kind": "engage", "claim_id": "claim-crl-0002", "initiator": "ACTOR_KIND_AGENT" } },
    { "advance_ns": "20000000" },
    { "inject": { "kind": "verb_result", "result": { "ok": true, "detail": "hold complete, arms at rest", "tNs": "350000000" } } },
    { "expect_state": { "episode.state": "EPISODE_STATE_INTERVENTION", "gate.mode": "GATE_MODE_INTERVENTION", "claim.active_claim_id": "claim-crl-0002" } },

    { "advance_ns": "10000000" },
    { "inject": { "kind": "intervention_chunk", "chunk": { "seq": "7", "sourceId": "agent-waddle-2", "tEmittedNs": "360000000", "tObsNs": "360000000", "horizonNs": "100000000", "provenance": { "kind": "PROVENANCE_KIND_AGENT", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-2" } }, "actions": [
      { "tOffsetNs": "0", "part": "left", "jointPosition": { "values": [0.14, -0.36, 0.33, -1.16, 0.08, 0.93] } }
    ] } } },
    { "expect_emission": { "event": { "fault": { "kind": "FAULT_KIND_VALIDATION_ERROR", "source": "$nonempty" } }, "within_ns": "0" } },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "360000000" } },
    { "expect_output": { "kind": "hold" } }
  ]
}
