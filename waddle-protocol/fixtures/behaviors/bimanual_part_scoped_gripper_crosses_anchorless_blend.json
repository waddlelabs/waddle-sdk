    ] }, "tOffsetNs": "0" } } },
    { "expect_output": { "kind": "blend", "part": "left", "provenance": { "kind": "PROVENANCE_KIND_AGENT" } } },
    { "expect_no_emission": { "event": { "fault": {} }, "within_ns": "0" } },

    { "advance_ns": "150000000" },
    { "inject": { "kind": "intervention_chunk", "chunk": { "seq": "3", "sourceId": "agent-waddle-1", "tEmittedNs": "550000000", "tObsNs": "550000000", "horizonNs": "100000000", "provenance": { "kind": "PROVENANCE_KIND_AGENT", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1" } }, "actions": [
      { "tOffsetNs": "0", "part": "left", "jointPosition": { "values": [0.14, -0.36, 0.31, -1.16, 0.06, 0.91, 0.20] } }
    ] } } },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "550000000", "action": { "composite": { "parts": [
      { "name": "left", "action": { "jointPosition": { "values": [0.14, -0.36, 0.30, -1.16, 0.05, 0.90, 0.70] } } },
      { "name": "right", "action": { "jointPosition": { "values": [-0.14, -0.36, 0.30, -1.16, -0.05, 0.90, 0.70] } } }
    ] }, "tOffsetNs": "0" } } },
    { "expect_output": { "kind": "substitute", "part": "left", "provenance": { "kind": "PROVENANCE_KIND_AGENT" } } },
    { "expect_state": { "episode.state": "EPISODE_STATE_INTERVENTION", "gate.mode": "GATE_MODE_INTERVENTION" } }
  ]
