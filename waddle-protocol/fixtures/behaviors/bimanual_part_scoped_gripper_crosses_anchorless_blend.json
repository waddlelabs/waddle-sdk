      { "name": "right", "action": { "jointPosition": { "values": [-0.12, -0.38, 0.30, -1.18, -0.05, 0.90, 0.70] } } }
    ] }, "tOffsetNs": "0" } } },
    { "expect_output": { "kind": "hold" } },
    { "expect_no_emission": { "event": { "fault": {} }, "within_ns": "0" } },

