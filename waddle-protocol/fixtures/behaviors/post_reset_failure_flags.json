{
  "format": "waddle.behavior/v0",
  "name": "post_reset_failure_flags",
  "description": "Pins FSM.md E16: a post-reset pipeline reporting ok:false never touches the pinned outcome — the episode still reaches TERMINAL{SUCCESS} (the outcome earned before cleanup), but permanently records the incident via the set_flag{post_reset_failed} effect and a Fault event, in the exact E16 emission order: set_flag{post_reset_failed}, PostResetResult{ok:false}, Fault, state{→TERMINAL, SUCCESS unchanged}.",
  "target": "fsm",
  "requires_features": ["waddle.v0.core", "waddle.v0.reset.phases"],
  "setup": {
    "lease_enforcement": "LEASE_ENFORCEMENT_ENFORCED",
    "handoff": { "immediate": { "blendNs": "0" } },
    "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING"
  },
  "steps": [
    { "inject": { "kind": "episode_open", "episode_id": "ep-prf-0001", "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING", "post_reset": true } },
    { "advance_ns": "100000000" },
    { "inject": { "kind": "reset_result", "result": { "ok": true, "strategy": "scripted_home", "verification": { "mode": "RESET_VERIFICATION_MODE_BLOCKING", "verified": true, "judgeId": "judge-reset", "judgeVersion": "2.1.0", "score": 0.95, "tNs": "100000000" } } } },
    { "inject": { "kind": "start" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_RUNNING" } },

    { "advance_ns": "100000000" },
    { "inject": { "kind": "terminate", "outcome": "TERMINAL_OUTCOME_SUCCESS", "reason": "task done" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_POST_RESET", "episode.pinned_outcome": "TERMINAL_OUTCOME_SUCCESS" } },

    { "advance_ns": "100000000" },
    { "inject": { "kind": "post_reset_result", "result": { "ok": false, "detail": "cleanup script failed" } } },
    { "expect_emission": { "effect": { "set_flag": { "flag": "post_reset_failed" } }, "within_ns": "0" } },
    { "expect_emission": { "event": { "postReset": { "result": { "ok": false }, "pinnedOutcome": "TERMINAL_OUTCOME_SUCCESS" } }, "within_ns": "0" } },
    { "expect_emission": { "event": { "fault": { "kind": "FAULT_KIND_PRECONDITION_FAIL" } }, "within_ns": "0" } },
    { "expect_emission": { "event": { "state": { "to": "EPISODE_STATE_TERMINAL", "outcome": "TERMINAL_OUTCOME_SUCCESS" } }, "within_ns": "0" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_TERMINAL", "episode.outcome": "TERMINAL_OUTCOME_SUCCESS", "episode.pinned_outcome": "TERMINAL_OUTCOME_SUCCESS", "episode.post_reset_failed": true } }
  ]
}
