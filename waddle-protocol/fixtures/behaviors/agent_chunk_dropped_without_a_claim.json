{
  "format": "waddle.behavior/v0",
  "name": "agent_chunk_dropped_without_a_claim",
  "description": "The other side of agent_chunk_buffers_during_engage_handoff: with NO claim there is nobody to buffer for, so a GateServerMessage.intervention_chunk is dropped outright — and dropped silently, with no Fault on the episode's timeline, because an unclaimed sender is not a sender that disagrees about the declared space. The drop must be real and not a deferral: after a claim is granted and engaged, the first caller tick returns hold (the unclaimed chunk did not survive into the claim window, which would have actuated a stale command under a claimant who never sent it), and a chunk sent under the claim substitutes normally, so the stream is not wedged either. Judgment calls: the episode is RUNNING under the policy when the stray chunk arrives — the same shape as a plane that streams a chunk just after a claim ended; the claim is ACTOR_KIND_AGENT because this arm is the one a hosted agent streams on; the chunks are part-scoped ('right') so a substitute is identifiable as a particular chunk's step; part names and the 7-value part width come from the bimanual fixture.",
  "target": "gate",
  "requires_features": ["waddle.v0.core", "waddle.v0.agent", "waddle.v0.parts"],
  "setup": {
    "robot_fixture": "../wire/robot_description_bimanual_composite.json",
    "lease_enforcement": "LEASE_ENFORCEMENT_ENFORCED",
    "handoff": { "holdFirst": {} },
    "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING"
  },
  "steps": [
    { "inject": { "kind": "episode_open", "episode_id": "ep-cnc-0001", "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING" } },
    { "advance_ns": "100000000" },
    { "inject": { "kind": "reset_result", "result": { "ok": true, "strategy": "scripted_home", "verification": { "mode": "RESET_VERIFICATION_MODE_BLOCKING", "verified": true, "judgeId": "judge-reset", "judgeVersion": "2.1.0", "score": 0.97, "tNs": "100000000" } } } },
    { "expect_state": { "episode.state": "EPISODE_STATE_READY" } },

    { "advance_ns": "100000000" },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "200000000" } },
    { "expect_output": { "kind": "pass" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_RUNNING", "gate.mode": "GATE_MODE_PASSTHROUGH", "claim.active_claim_id": "" } },

    { "inject": { "kind": "intervention_chunk", "chunk": { "seq": "1", "sourceId": "agent-waddle-1", "tEmittedNs": "200000000", "tObsNs": "200000000", "horizonNs": "400000000", "provenance": { "kind": "PROVENANCE_KIND_AGENT", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1" } }, "actions": [
      { "tOffsetNs": "0", "part": "right", "jointPosition": { "values": [-0.90, -0.10, 0.55, -0.80, -0.30, 1.10, 0.20] } }
    ] } } },
    { "expect_no_emission": { "event": { "fault": {} }, "within_ns": "0" } },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "200000000" } },
    { "expect_output": { "kind": "pass" } },

    { "inject": { "kind": "claim_granted", "claim": { "claimId": "claim-cnc-0001", "episodeId": "ep-cnc-0001", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1", "displayName": "Waddle agent" }, "sourceName": "waddle-agent", "selfInitiated": false, "tGrantedNs": "200000000", "handoff": { "holdFirst": {} }, "spaces": ["SPACE_KIND_JOINT_POSITION"] } } },
    { "inject": { "kind": "engage", "claim_id": "claim-cnc-0001", "initiator": "ACTOR_KIND_AGENT" } },
    { "advance_ns": "50000000" },
    { "inject": { "kind": "verb_result", "result": { "ok": true, "detail": "hold complete, arms at rest", "tNs": "250000000" } } },
    { "expect_emission": { "event": { "lease": { "kind": "LEASE_EVENT_KIND_HANDED_OFF", "lease": { "leaseId": "$fresh_lease" } } }, "within_ns": "0" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_INTERVENTION", "gate.mode": "GATE_MODE_INTERVENTION" } },

    { "inject": { "kind": "gate_tick", "obs_t_ns": "250000000" } },
    { "expect_output": { "kind": "hold" } },

    { "advance_ns": "50000000" },
    { "inject": { "kind": "intervention_chunk", "chunk": { "seq": "2", "sourceId": "agent-waddle-1", "tEmittedNs": "300000000", "tObsNs": "300000000", "horizonNs": "200000000", "provenance": { "kind": "PROVENANCE_KIND_AGENT", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1" } }, "actions": [
      { "tOffsetNs": "0", "part": "right", "jointPosition": { "values": [-0.12, -0.38, 0.31, -1.18, -0.06, 0.91, 0.20] } }
    ] } } },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "300000000" } },
    { "expect_output": { "kind": "substitute", "part": "right", "provenance": { "kind": "PROVENANCE_KIND_AGENT" } } },
    { "expect_no_emission": { "event": { "fault": {} }, "within_ns": "0" } }
  ]
}
