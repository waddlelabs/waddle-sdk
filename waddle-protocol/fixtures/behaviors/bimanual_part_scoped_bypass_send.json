{
  "format": "waddle.behavior/v0",
  "name": "bimanual_part_scoped_bypass_send",
  "description": "Pins part addressing on the one path where an intervention action reaches the robot without passing through gate(): the bypass pump (FSM.md §5). The caller loop stalls past the threshold while a hosted agent's part-scoped chunk is buffered, the gate goes to BYPASS, and the pump dispatches the action through the integrator's declared send verb — which must carry the part it addresses ('right'), exactly as a gate-returned substitute does, or a stalled bimanual session's recording cannot say which arm moved. A whole-robot chunk sent in the same bypass window dispatches with part '', so a scenario can pin either fact rather than inferring it from the width. Judgment calls: the stall threshold and the pump's cadence are implementation-declared (conformance/timing-envelopes.md), so the fixture stalls for 600 ms — well past any plausible threshold — and allows the pump 200 ms to dispatch; the claim is ACTOR_KIND_AGENT because GateServerMessage.intervention_chunk is the arm a hosted agent streams on; HOLD_FIRST so no blend window is open; part names and the 7-value part width come from the bimanual fixture.",
  "target": "gate",
  "requires_features": ["waddle.v0.core", "waddle.v0.agent", "waddle.v0.parts"],
  "setup": {
    "robot_fixture": "../wire/robot_description_bimanual_composite.json",
    "lease_enforcement": "LEASE_ENFORCEMENT_ADVISORY",
    "handoff": { "holdFirst": {} },
    "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING"
  },
  "steps": [
    { "inject": { "kind": "episode_open", "episode_id": "ep-pbs-0001", "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING" } },
    { "advance_ns": "100000000" },
    { "inject": { "kind": "reset_result", "result": { "ok": true, "strategy": "scripted_home", "verification": { "mode": "RESET_VERIFICATION_MODE_BLOCKING", "verified": true, "judgeId": "judge-reset", "judgeVersion": "2.1.0", "score": 0.97, "tNs": "100000000" } } } },
    { "expect_state": { "episode.state": "EPISODE_STATE_READY" } },

    { "advance_ns": "100000000" },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "200000000" } },
    { "expect_output": { "kind": "pass" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_RUNNING", "gate.mode": "GATE_MODE_PASSTHROUGH" } },

    { "inject": { "kind": "claim_granted", "claim": { "claimId": "claim-pbs-0001", "episodeId": "ep-pbs-0001", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1", "displayName": "Waddle agent" }, "sourceName": "waddle-agent", "selfInitiated": false, "tGrantedNs": "200000000", "handoff": { "holdFirst": {} }, "spaces": ["SPACE_KIND_JOINT_POSITION"] } } },
    { "inject": { "kind": "engage", "claim_id": "claim-pbs-0001", "initiator": "ACTOR_KIND_AGENT" } },
    { "advance_ns": "50000000" },
    { "inject": { "kind": "verb_result", "result": { "ok": true, "detail": "hold complete, arms at rest", "tNs": "250000000" } } },
    { "expect_emission": { "event": { "lease": { "kind": "LEASE_EVENT_KIND_HANDED_OFF", "lease": { "leaseId": "$fresh_lease" } } }, "within_ns": "0" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_INTERVENTION", "gate.mode": "GATE_MODE_INTERVENTION" } },

    { "advance_ns": "50000000" },
    { "inject": { "kind": "intervention_chunk", "chunk": { "seq": "1", "sourceId": "agent-waddle-1", "tEmittedNs": "300000000", "tObsNs": "300000000", "horizonNs": "200000000", "provenance": { "kind": "PROVENANCE_KIND_AGENT", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1" } }, "actions": [
      { "tOffsetNs": "0", "part": "right", "jointPosition": { "values": [-0.90, -0.10, 0.55, -0.80, -0.30, 1.10, 0.20] } }
    ] } } },

    { "expect_emission": { "event": { "gate": { "from": "GATE_MODE_INTERVENTION", "to": "GATE_MODE_BYPASS" } }, "within_ns": "600000000" } },
    { "expect_send": { "provenance": { "kind": "PROVENANCE_KIND_AGENT" }, "part": "right", "within_ns": "200000000" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_INTERVENTION", "gate.mode": "GATE_MODE_BYPASS" } },

    { "inject": { "kind": "intervention_chunk", "chunk": { "seq": "2", "sourceId": "agent-waddle-1", "tEmittedNs": "1000000000", "tObsNs": "1000000000", "horizonNs": "200000000", "provenance": { "kind": "PROVENANCE_KIND_AGENT", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1" } }, "actions": [
      { "tOffsetNs": "0", "composite": { "parts": [
        { "name": "left", "action": { "jointPosition": { "values": [0.14, -0.36, 0.31, -1.16, 0.06, 0.91, 0.20] } } },
        { "name": "right", "action": { "jointPosition": { "values": [-0.14, -0.36, 0.31, -1.16, -0.06, 0.91, 0.20] } } }
      ] } }
    ] } } },
    { "expect_send": { "provenance": { "kind": "PROVENANCE_KIND_AGENT" }, "part": "", "within_ns": "200000000" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_INTERVENTION", "gate.mode": "GATE_MODE_BYPASS" } }
  ]
}
