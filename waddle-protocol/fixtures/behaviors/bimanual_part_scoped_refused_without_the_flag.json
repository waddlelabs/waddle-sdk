{
  "format": "waddle.behavior/v0",
  "name": "bimanual_part_scoped_refused_without_the_flag",
  "description": "Pins the PRE-FLAG direction of docs/VERSIONING.md's waddle.v0.parts registry row: on a connection that did NOT negotiate the flag, Action.part keeps its pre-flag meaning — every action is read against the WHOLE declared space — even though the robot is a Composite with parts to address. So a chunk addressing 'left' on a left/right bimanual declaration does not fit the declared space, the whole chunk is refused, nothing reaches the intervention stream (gate_tick holds), and the refusal is recorded as Fault{FAULT_KIND_VALIDATION_ERROR} naming the intake, once per claim window. This is the behavior the registry row promises a plane may rely on — 'will refuse' rather than 'will execute' is exactly the discrimination the flag mechanism exists to make — so it is pinned here rather than left to an implementation. The last two steps prove the pre-flag reading is whole-space and not blanket refusal: a whole-robot chunk in the SAME window still substitutes, and its output carries part '' — the tag is never minted on an unflagged connection. Note what makes this scenario expressible at all: 'requires_features' is the negotiation the runner models, so omitting waddle.v0.parts is what a pre-flag connection IS; a runner that has not implemented the flag skips every flagged sibling and still runs this one, which is the outcome the skip rule asks for. Judgment calls: HOLD_FIRST handoff so the holds are the intake's refusal and not the blend defense of FSM.md §5; ACTOR_KIND_AGENT claim on a non-invited episode (the intervention_chunk arm's v0 producer); the fault's source and detail are asserted as $nonempty, never as literals — Fault.source is implementation-named (control.proto: 'who raised it') and the detail's wording is an implementation's to phrase.",
  "target": "gate",
  "requires_features": ["waddle.v0.core", "waddle.v0.agent"],
  "setup": {
    "robot_fixture": "../wire/robot_description_bimanual_composite.json",
    "lease_enforcement": "LEASE_ENFORCEMENT_ENFORCED",
    "handoff": { "holdFirst": {} },
    "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING"
  },
  "steps": [
    { "inject": { "kind": "episode_open", "episode_id": "ep-bpf-0001", "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING" } },
    { "advance_ns": "100000000" },
    { "inject": { "kind": "reset_result", "result": { "ok": true, "strategy": "scripted_home", "verification": { "mode": "RESET_VERIFICATION_MODE_BLOCKING", "verified": true, "judgeId": "judge-reset", "judgeVersion": "2.1.0", "score": 0.94, "tNs": "100000000" } } } },
    { "expect_state": { "episode.state": "EPISODE_STATE_READY" } },

    { "advance_ns": "100000000" },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "200000000", "action": { "composite": { "parts": [
      { "name": "left", "action": { "jointPosition": { "values": [0.10, -0.40, 0.30, -1.20, 0.05, 0.90, 0.70] } } },
      { "name": "right", "action": { "jointPosition": { "values": [-0.10, -0.40, 0.30, -1.20, -0.05, 0.90, 0.70] } } }
    ] }, "tOffsetNs": "0" } } },
    { "expect_output": { "kind": "pass" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_RUNNING", "gate.mode": "GATE_MODE_PASSTHROUGH" } },

    { "inject": { "kind": "claim_granted", "claim": { "claimId": "claim-bpf-0001", "episodeId": "ep-bpf-0001", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1", "displayName": "Waddle agent" }, "sourceName": "waddle-agent", "selfInitiated": false, "tGrantedNs": "200000000", "handoff": { "holdFirst": {} }, "spaces": ["SPACE_KIND_JOINT_POSITION"] } } },
    { "inject": { "kind": "engage", "claim_id": "claim-bpf-0001", "initiator": "ACTOR_KIND_AGENT" } },
    { "advance_ns": "50000000" },
    { "inject": { "kind": "verb_result", "result": { "ok": true, "detail": "hold complete, arms at rest", "tNs": "250000000" } } },
    { "expect_emission": { "event": { "lease": { "kind": "LEASE_EVENT_KIND_HANDED_OFF" } }, "within_ns": "0" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_INTERVENTION", "gate.mode": "GATE_MODE_INTERVENTION" } },

    { "advance_ns": "50000000" },
    { "inject": { "kind": "intervention_chunk", "chunk": { "seq": "1", "sourceId": "agent-waddle-1", "tEmittedNs": "300000000", "tObsNs": "300000000", "horizonNs": "100000000", "provenance": { "kind": "PROVENANCE_KIND_AGENT", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1" } }, "actions": [
      { "tOffsetNs": "0", "part": "left", "jointPosition": { "values": [0.12, -0.38, 0.31, -1.18, 0.06, 0.91, 0.20] } }
    ] } } },
    { "expect_emission": { "event": { "fault": { "kind": "FAULT_KIND_VALIDATION_ERROR", "source": "$nonempty", "detail": "$nonempty" } }, "within_ns": "0" } },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "300000000", "action": { "composite": { "parts": [
      { "name": "left", "action": { "jointPosition": { "values": [0.10, -0.40, 0.30, -1.20, 0.05, 0.90, 0.70] } } },
      { "name": "right", "action": { "jointPosition": { "values": [-0.10, -0.40, 0.30, -1.20, -0.05, 0.90, 0.70] } } }
    ] }, "tOffsetNs": "0" } } },
    { "expect_output": { "kind": "hold" } },

    { "advance_ns": "50000000" },
    { "inject": { "kind": "intervention_chunk", "chunk": { "seq": "2", "sourceId": "agent-waddle-1", "tEmittedNs": "350000000", "tObsNs": "350000000", "horizonNs": "100000000", "provenance": { "kind": "PROVENANCE_KIND_AGENT", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1" } }, "actions": [
      { "tOffsetNs": "0", "part": "left", "jointPosition": { "values": [0.13, -0.37, 0.31, -1.17, 0.06, 0.91, 0.20] } }
    ] } } },
    { "expect_no_emission": { "event": { "fault": {} }, "within_ns": "0" } },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "350000000", "action": { "composite": { "parts": [
      { "name": "left", "action": { "jointPosition": { "values": [0.10, -0.40, 0.30, -1.20, 0.05, 0.90, 0.70] } } },
      { "name": "right", "action": { "jointPosition": { "values": [-0.10, -0.40, 0.30, -1.20, -0.05, 0.90, 0.70] } } }
    ] }, "tOffsetNs": "0" } } },
    { "expect_output": { "kind": "hold" } },

    { "advance_ns": "50000000" },
    { "inject": { "kind": "intervention_chunk", "chunk": { "seq": "3", "sourceId": "agent-waddle-1", "tEmittedNs": "400000000", "tObsNs": "400000000", "horizonNs": "100000000", "provenance": { "kind": "PROVENANCE_KIND_AGENT", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1" } }, "actions": [
      { "tOffsetNs": "0", "composite": { "parts": [
        { "name": "left", "action": { "jointPosition": { "values": [0.14, -0.36, 0.31, -1.16, 0.06, 0.91, 0.20] } } },
        { "name": "right", "action": { "jointPosition": { "values": [-0.14, -0.36, 0.31, -1.16, -0.06, 0.91, 0.20] } } }
      ] } }
    ] } } },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "400000000", "action": { "composite": { "parts": [
      { "name": "left", "action": { "jointPosition": { "values": [0.10, -0.40, 0.30, -1.20, 0.05, 0.90, 0.70] } } },
      { "name": "right", "action": { "jointPosition": { "values": [-0.10, -0.40, 0.30, -1.20, -0.05, 0.90, 0.70] } } }
    ] }, "tOffsetNs": "0" } } },
    { "expect_output": { "kind": "substitute", "part": "", "provenance": { "kind": "PROVENANCE_KIND_AGENT" } } },
    { "expect_state": { "episode.state": "EPISODE_STATE_INTERVENTION", "gate.mode": "GATE_MODE_INTERVENTION" } }
  ]
}
