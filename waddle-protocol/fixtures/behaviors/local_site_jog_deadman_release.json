{
  "format": "waddle.behavior/v0",
  "name": "local_site_jog_deadman_release",
  "description": "Pins FSM.md §4's local site-operator jog adapter: the adapter grants one self-initiated SITE_OPERATOR claim, engages it through the ordinary handoff path, and after its core-owned one-second deadman deadline injects the ordinary release transition. The deadline itself is held by the runtime adapter (and tested with an injected clock); the scenario pins the resulting existing claim/lease/gate transition so no frontend can invent a parallel authority path.",
  "target": "fsm",
  "requires_features": ["waddle.v0.core"],
  "setup": {
    "lease_enforcement": "LEASE_ENFORCEMENT_ENFORCED",
    "handoff": { "immediate": { "blendNs": "0" } },
    "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING"
  },
  "steps": [
    { "inject": { "kind": "episode_open", "episode_id": "ep-local-jog-0001", "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING" } },
    { "advance_ns": "100000000" },
    { "inject": { "kind": "reset_result", "result": { "ok": true, "strategy": "scripted_home", "verification": { "mode": "RESET_VERIFICATION_MODE_BLOCKING", "verified": true, "judgeId": "judge-reset", "judgeVersion": "2.1.0", "score": 0.95, "tNs": "100000000" } } } },
    { "inject": { "kind": "start" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_RUNNING", "claim.active_claim_id": "" } },

    { "inject": { "kind": "claim_granted", "claim": { "claimId": "claim-local-jog-0001", "episodeId": "ep-local-jog-0001", "actor": { "kind": "ACTOR_KIND_SITE_OPERATOR", "id": "local-ui" }, "sourceName": "local-ui-jog", "selfInitiated": true, "tGrantedNs": "100000000", "handoff": { "immediate": { "blendNs": "0" } }, "spaces": ["SPACE_KIND_JOINT_POSITION", "SPACE_KIND_EE_POSE_DELTA"] } } },
    { "expect_emission": { "event": { "claim": { "kind": "CLAIM_EVENT_KIND_GRANTED", "claim": { "claimId": "claim-local-jog-0001", "sourceName": "local-ui-jog", "selfInitiated": true, "actor": { "kind": "ACTOR_KIND_SITE_OPERATOR", "id": "local-ui" } } } }, "within_ns": "0" } },
    { "inject": { "kind": "engage", "claim_id": "claim-local-jog-0001", "initiator": "ACTOR_KIND_SITE_OPERATOR" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_INTERVENTION", "claim.active_claim_id": "claim-local-jog-0001" } },

    { "advance_ns": "1000000000" },
    { "inject": { "kind": "release", "claim_id": "claim-local-jog-0001", "initiator": "ACTOR_KIND_SITE_OPERATOR" } },
    { "expect_emission": { "event": { "claim": { "kind": "CLAIM_EVENT_KIND_RELEASED", "claim": { "claimId": "claim-local-jog-0001", "actor": { "kind": "ACTOR_KIND_SITE_OPERATOR", "id": "local-ui" } } } }, "within_ns": "0" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_RUNNING", "claim.active_claim_id": "" } }
  ]
}
