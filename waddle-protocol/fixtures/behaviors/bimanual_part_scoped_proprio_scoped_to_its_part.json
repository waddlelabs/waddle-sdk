{
  "format": "waddle.behavior/v0",
  "name": "bimanual_part_scoped_proprio_scoped_to_its_part",
  "description": "Pins what N14 dual-write detection may compare once a command addresses ONE part (flag waddle.v0.parts): the commanded side and the observed side must describe the same scope. A part-scoped intervention on 'right' (7 values, the part's own width) is followed by proprioception reporting the robot doing EXACTLY what it was told — right at the commanded pose, left still at the last whole-robot command — reported first as whole-robot samples (14 values, part '') and then per part. No divergence exists, so no DualWriteDetected may fire and the intervenor must not be accused: a whole-robot sample is not comparable against a part-width command (the observation layout is the customer's own and is never re-laid-out by declared action parts), and a per-part sample is compared against that part's own command, or — for a part no part-scoped command has addressed — against the last whole-robot command's slice for it, which is pure declaration-order arithmetic on an action vector. Judgment calls: the divergence threshold and window are implementation-declared, so the three whole-robot samples span 160 ms — comfortably past any plausible window — and the fixture allows a further 100 ms for a (forbidden) incident to appear; ADVISORY enforcement and HOLD_FIRST as in dual_write_detection; the claim is ACTOR_KIND_AGENT because GateServerMessage.intervention_chunk is the arm a hosted agent streams on; part names 'left'/'right' and the 7-value part width come from the bimanual fixture.",
  "target": "gate",
  "requires_features": ["waddle.v0.core", "waddle.v0.agent", "waddle.v0.parts"],
  "setup": {
    "robot_fixture": "../wire/robot_description_bimanual_composite.json",
    "lease_enforcement": "LEASE_ENFORCEMENT_ADVISORY",
    "handoff": { "holdFirst": {} },
    "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING"
  },
  "steps": [
    { "inject": { "kind": "episode_open", "episode_id": "ep-pps-0001", "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING" } },
    { "advance_ns": "100000000" },
    { "inject": { "kind": "reset_result", "result": { "ok": true, "strategy": "scripted_home", "verification": { "mode": "RESET_VERIFICATION_MODE_BLOCKING", "verified": true, "judgeId": "judge-reset", "judgeVersion": "2.1.0", "score": 0.97, "tNs": "100000000" } } } },
    { "expect_state": { "episode.state": "EPISODE_STATE_READY" } },

    { "advance_ns": "100000000" },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "200000000", "action": { "composite": { "parts": [
      { "name": "left", "action": { "jointPosition": { "values": [0.10, -0.40, 0.30, -1.20, 0.05, 0.90, 0.70] } } },
      { "name": "right", "action": { "jointPosition": { "values": [-0.10, -0.40, 0.30, -1.20, -0.05, 0.90, 0.70] } } }
    ] }, "tOffsetNs": "0" } } },
    { "expect_output": { "kind": "pass" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_RUNNING", "gate.mode": "GATE_MODE_PASSTHROUGH" } },

    { "inject": { "kind": "claim_granted", "claim": { "claimId": "claim-pps-0001", "episodeId": "ep-pps-0001", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1", "displayName": "Waddle agent" }, "sourceName": "waddle-agent", "selfInitiated": false, "tGrantedNs": "200000000", "handoff": { "holdFirst": {} }, "spaces": ["SPACE_KIND_JOINT_POSITION"] } } },
    { "inject": { "kind": "engage", "claim_id": "claim-pps-0001", "initiator": "ACTOR_KIND_AGENT" } },
    { "advance_ns": "50000000" },
    { "inject": { "kind": "verb_result", "result": { "ok": true, "detail": "hold complete, arms at rest", "tNs": "250000000" } } },
    { "expect_emission": { "event": { "lease": { "kind": "LEASE_EVENT_KIND_HANDED_OFF", "lease": { "leaseId": "$fresh_lease" } } }, "within_ns": "0" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_INTERVENTION", "gate.mode": "GATE_MODE_INTERVENTION" } },

    { "advance_ns": "50000000" },
    { "inject": { "kind": "intervention_chunk", "chunk": { "seq": "1", "sourceId": "agent-waddle-1", "tEmittedNs": "300000000", "tObsNs": "300000000", "horizonNs": "200000000", "provenance": { "kind": "PROVENANCE_KIND_AGENT", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1" } }, "actions": [
      { "tOffsetNs": "0", "part": "right", "jointPosition": { "values": [-0.90, -0.10, 0.55, -0.80, -0.30, 1.10, 0.20] } }
    ] } } },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "300000000", "action": { "composite": { "parts": [
      { "name": "left", "action": { "jointPosition": { "values": [0.10, -0.40, 0.30, -1.20, 0.05, 0.90, 0.70] } } },
      { "name": "right", "action": { "jointPosition": { "values": [-0.10, -0.40, 0.30, -1.20, -0.05, 0.90, 0.70] } } }
    ] }, "tOffsetNs": "0" } } },
    { "expect_output": { "kind": "substitute", "part": "right", "provenance": { "kind": "PROVENANCE_KIND_AGENT" } } },

    { "inject": { "kind": "proprio_sample", "t_ns": "300000000", "sample": { "part": "", "jointPos": [0.10, -0.40, 0.30, -1.20, 0.05, 0.90, 0.70, -0.90, -0.10, 0.55, -0.80, -0.30, 1.10, 0.20] } } },
    { "advance_ns": "80000000" },
    { "inject": { "kind": "proprio_sample", "t_ns": "380000000", "sample": { "part": "", "jointPos": [0.10, -0.40, 0.30, -1.20, 0.05, 0.90, 0.70, -0.90, -0.10, 0.55, -0.80, -0.30, 1.10, 0.20] } } },
    { "advance_ns": "80000000" },
    { "inject": { "kind": "proprio_sample", "t_ns": "460000000", "sample": { "part": "", "jointPos": [0.10, -0.40, 0.30, -1.20, 0.05, 0.90, 0.70, -0.90, -0.10, 0.55, -0.80, -0.30, 1.10, 0.20] } } },

    { "inject": { "kind": "proprio_sample", "t_ns": "460000000", "sample": { "part": "right", "jointPos": [-0.90, -0.10, 0.55, -0.80, -0.30, 1.10, 0.20] } } },
    { "inject": { "kind": "proprio_sample", "t_ns": "460000000", "sample": { "part": "left", "jointPos": [0.10, -0.40, 0.30, -1.20, 0.05, 0.90, 0.70] } } },

    { "expect_no_emission": { "event": { "dualWrite": {} }, "within_ns": "100000000" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_INTERVENTION", "gate.mode": "GATE_MODE_INTERVENTION" } }
  ]
}
