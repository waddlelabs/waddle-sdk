{
  "format": "waddle.behavior/v0",
  "name": "retake_operator_optimistic",
  "description": "Pins FSM.md E9, C5, E3, E13 and §1.2 (N2/N12/N18) for a teleoperator retake: from INTERVENTION settle, retake terminates the predecessor with TERMINAL_OUTCOME_ABORTED_RETAKE and emits the open_successor effect carrying the still-held claim ($active_claim), born_claimed, and RESET_VERIFICATION_MODE_OPTIMISTIC_ASYNC (operator flow is sacred); the successor opens RESETTING under the surviving claim, enters READY on reset_result{ok} with verification pending (E3), runs, and a LATE verification_result{verified:false, invalidated_async} leaves the state unchanged while setting the permanent reset_unverified flag via the set_flag effect (E13). Judgment calls: the fsm target reaches INTERVENTION_PHASE_SETTLE by the engage handoff completing (I1/I2) plus a 300 ms advance, with an IMMEDIATE{blend_ns:0} handoff so no gate ticks are needed; effect field names follow scenario-format.md's snake_case effects table.",
  "target": "fsm",
  "requires_features": ["waddle.v0.core"],
  "setup": {
    "lease_enforcement": "LEASE_ENFORCEMENT_ENFORCED",
    "handoff": { "immediate": { "blendNs": "0" } },
    "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING"
  },
  "steps": [
    { "inject": { "kind": "episode_open", "episode_id": "int-aaaa000001", "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING" } },
    { "advance_ns": "100000000" },
    { "inject": { "kind": "reset_result", "result": { "ok": true, "strategy": "scripted_home", "verification": { "mode": "RESET_VERIFICATION_MODE_BLOCKING", "verified": true, "judgeId": "judge-reset", "judgeVersion": "2.1.0", "score": 0.96, "tNs": "100000000" } } } },
    { "expect_state": { "episode.state": "EPISODE_STATE_READY" } },
    { "inject": { "kind": "start" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_RUNNING" } },
    { "advance_ns": "100000000" },
    { "inject": { "kind": "claim_granted", "claim": { "claimId": "claim-ret-0001", "episodeId": "int-aaaa000001", "actor": { "kind": "ACTOR_KIND_TELEOPERATOR", "id": "top-7", "displayName": "Teleoperator 7" }, "sourceName": "teleop", "selfInitiated": false, "tGrantedNs": "200000000", "handoff": { "immediate": { "blendNs": "0" } }, "spaces": ["SPACE_KIND_EE_POSE_DELTA"] } } },
    { "inject": { "kind": "engage", "claim_id": "claim-ret-0001", "initiator": "ACTOR_KIND_TELEOPERATOR" } },
    { "expect_emission": { "event": { "lease": { "kind": "LEASE_EVENT_KIND_HANDED_OFF" } }, "within_ns": "0" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_INTERVENTION" } },
    { "advance_ns": "300000000" },
    { "expect_state": { "episode.intervention_phase": "INTERVENTION_PHASE_SETTLE" } },
    { "inject": { "kind": "retake", "claim_id": "claim-ret-0001", "initiator": "ACTOR_KIND_TELEOPERATOR", "successor_episode_id": "int-aaaa000002" } },
    { "expect_emission": { "event": { "state": { "to": "EPISODE_STATE_TERMINAL", "outcome": "TERMINAL_OUTCOME_ABORTED_RETAKE" } }, "within_ns": "0" } },
    { "expect_emission": { "effect": { "open_successor": { "predecessor_episode_id": "int-aaaa000001", "claim_id": "$active_claim", "born_claimed": true, "verification_mode": "RESET_VERIFICATION_MODE_OPTIMISTIC_ASYNC" } }, "within_ns": "0" } },
    { "inject": { "kind": "episode_open", "episode_id": "int-aaaa000002", "verification_mode": "RESET_VERIFICATION_MODE_OPTIMISTIC_ASYNC", "born_claimed": true, "parent_episode_id": "int-aaaa000001" } },
    { "expect_state": { "episode.id": "int-aaaa000002", "episode.state": "EPISODE_STATE_RESETTING", "episode.born_claimed": true, "episode.parent_episode_id": "int-aaaa000001", "claim.active_claim_id": "$active_claim" } },
    { "advance_ns": "200000000" },
    { "inject": { "kind": "reset_result", "result": { "ok": true, "strategy": "teleop_scene_reset" } } },
    { "expect_state": { "episode.state": "EPISODE_STATE_READY" } },
    { "inject": { "kind": "start" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_RUNNING", "claim.active_claim_id": "$active_claim" } },
    { "advance_ns": "1000000000" },
    { "inject": { "kind": "verification_result", "verification": { "mode": "RESET_VERIFICATION_MODE_OPTIMISTIC_ASYNC", "verified": false, "invalidatedAsync": true, "judgeId": "judge-reset", "judgeVersion": "2.1.0", "score": 0.28, "tNs": "1700000000" } } },
    { "expect_emission": { "effect": { "set_flag": { "flag": "reset_unverified" } }, "within_ns": "0" } },
    { "expect_emission": { "event": { "resetVerification": { "verified": false, "invalidatedAsync": true } }, "within_ns": "0" } },
    { "expect_state": { "episode.reset_unverified": true, "episode.state": "EPISODE_STATE_RUNNING" } }
  ]
}
