{
  "format": "waddle.behavior/v0",
  "name": "handoff_chunk_boundary",
  "description": "Pins FSM.md §5 CHUNK_BOUNDARY{max_wait_ns} (with E7, I1, L6): engage while a chunk is executing must NOT hand the lease off inside the remaining-chunk window — caller ticks keep passing the executing chunk (provenance POLICY) — and the handoff (fresh token) fires when the chunk finishes, after which teleop actions substitute. The maxWait cap path is declared but not exercised here: with remaining horizon greater than maxWaitNs (200000000) the handoff must instead fire at engage+maxWaitNs; this scenario engages 180 ms before chunk end so the boundary, not the cap, wins. Judgment calls: the no-handoff window is asserted only up to the last chunk action's dispatch tick (t=600ms) so implementations that hand off at last-action-dispatch rather than horizon-end both conform; the HANDED_OFF expectation uses a 150 ms forward window covering both readings; part names 'left'/'right' assumed from the bimanual fixture.",
  "target": "gate",
  "requires_features": ["waddle.v0.core"],
  "setup": {
    "robot_fixture": "../wire/robot_description_bimanual_composite.json",
    "lease_enforcement": "LEASE_ENFORCEMENT_ENFORCED",
    "handoff": { "chunkBoundary": { "maxWaitNs": "200000000" } },
    "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING"
  },
  "steps": [
    { "inject": { "kind": "episode_open", "episode_id": "ep-cb-0001", "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING" } },
    { "advance_ns": "100000000" },
    { "inject": { "kind": "reset_result", "result": { "ok": true, "strategy": "scripted_home", "verification": { "mode": "RESET_VERIFICATION_MODE_BLOCKING", "verified": true, "judgeId": "judge-reset", "judgeVersion": "2.1.0", "score": 0.95, "tNs": "100000000" } } } },
    { "expect_state": { "episode.state": "EPISODE_STATE_READY" } },
    { "inject": { "kind": "chunk_arrival", "chunk": { "seq": "1", "sourceId": "policy-main", "tEmittedNs": "100000000", "tObsNs": "100000000", "horizonNs": "600000000", "provenance": { "kind": "PROVENANCE_KIND_POLICY", "actor": { "kind": "ACTOR_KIND_POLICY", "id": "policy-main" } }, "actions": [
      { "tOffsetNs": "0", "composite": { "parts": [ { "name": "left", "action": { "jointPosition": { "values": [0.10, -0.40, 0.30, -1.20, 0.05, 0.90] } } }, { "name": "right", "action": { "jointPosition": { "values": [-0.10, -0.40, 0.30, -1.20, -0.05, 0.90] } } } ] } },
      { "tOffsetNs": "100000000", "composite": { "parts": [ { "name": "left", "action": { "jointPosition": { "values": [0.11, -0.39, 0.30, -1.19, 0.05, 0.90] } } }, { "name": "right", "action": { "jointPosition": { "values": [-0.11, -0.39, 0.30, -1.19, -0.05, 0.90] } } } ] } },
      { "tOffsetNs": "200000000", "composite": { "parts": [ { "name": "left", "action": { "jointPosition": { "values": [0.12, -0.38, 0.30, -1.18, 0.05, 0.90] } } }, { "name": "right", "action": { "jointPosition": { "values": [-0.12, -0.38, 0.30, -1.18, -0.05, 0.90] } } } ] } },
      { "tOffsetNs": "300000000", "composite": { "parts": [ { "name": "left", "action": { "jointPosition": { "values": [0.13, -0.37, 0.30, -1.17, 0.05, 0.90] } } }, { "name": "right", "action": { "jointPosition": { "values": [-0.13, -0.37, 0.30, -1.17, -0.05, 0.90] } } } ] } },
      { "tOffsetNs": "400000000", "composite": { "parts": [ { "name": "left", "action": { "jointPosition": { "values": [0.14, -0.36, 0.30, -1.16, 0.05, 0.90] } } }, { "name": "right", "action": { "jointPosition": { "values": [-0.14, -0.36, 0.30, -1.16, -0.05, 0.90] } } } ] } },
      { "tOffsetNs": "500000000", "composite": { "parts": [ { "name": "left", "action": { "jointPosition": { "values": [0.15, -0.35, 0.30, -1.15, 0.05, 0.90] } } }, { "name": "right", "action": { "jointPosition": { "values": [-0.15, -0.35, 0.30, -1.15, -0.05, 0.90] } } } ] } }
    ] } } },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "100000000" } },
    { "expect_output": { "kind": "pass" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_RUNNING", "gate.mode": "GATE_MODE_PASSTHROUGH" } },
    { "advance_ns": "100000000" },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "200000000" } },
    { "expect_output": { "kind": "pass" } },
    { "advance_ns": "100000000" },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "300000000" } },
    { "advance_ns": "100000000" },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "400000000" } },
    { "advance_ns": "100000000" },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "500000000" } },
    { "advance_ns": "20000000" },
    { "inject": { "kind": "claim_granted", "claim": { "claimId": "claim-cb-0001", "episodeId": "ep-cb-0001", "actor": { "kind": "ACTOR_KIND_TELEOPERATOR", "id": "top-7", "displayName": "Teleoperator 7" }, "sourceName": "teleop", "selfInitiated": false, "tGrantedNs": "520000000", "handoff": { "chunkBoundary": { "maxWaitNs": "200000000" } }, "spaces": ["SPACE_KIND_EE_POSE_DELTA"] } } },
    { "inject": { "kind": "engage", "claim_id": "claim-cb-0001", "initiator": "ACTOR_KIND_TELEOPERATOR" } },
    { "inject": { "kind": "teleop_action", "packet": { "tClientNs": "42000000000", "seq": "1", "clutchEngaged": true, "targets": [
      { "part": "left", "twist": { "linear": { "x": 0.005, "y": 0.0, "z": 0.0 }, "angular": { "x": 0.0, "y": 0.0, "z": 0.0 } } }
    ] } } },
    { "expect_no_emission": { "event": { "lease": { "kind": "LEASE_EVENT_KIND_HANDED_OFF" } }, "within_ns": "60000000" } },
    { "advance_ns": "20000000" },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "600000000" } },
    { "expect_output": { "kind": "pass", "provenance": { "kind": "PROVENANCE_KIND_POLICY" } } },
    { "expect_emission": { "event": { "lease": { "kind": "LEASE_EVENT_KIND_HANDED_OFF", "lease": { "leaseId": "$fresh_lease" } } }, "within_ns": "150000000" } },
    { "expect_emission": { "event": { "gate": { "from": "GATE_MODE_PASSTHROUGH", "to": "GATE_MODE_INTERVENTION" } }, "within_ns": "0" } },
    { "inject": { "kind": "teleop_action", "packet": { "tClientNs": "42200000000", "seq": "2", "clutchEngaged": true, "targets": [
      { "part": "left", "twist": { "linear": { "x": 0.004, "y": 0.001, "z": 0.0 }, "angular": { "x": 0.0, "y": 0.0, "z": 0.0 } } }
    ] } } },
    { "inject": { "kind": "gate_tick", "obs_t_ns": "760000000" } },
    { "expect_output": { "kind": "substitute", "provenance": { "kind": "PROVENANCE_KIND_TELEOP" } } },
    { "expect_state": { "episode.state": "EPISODE_STATE_INTERVENTION", "gate.mode": "GATE_MODE_INTERVENTION" } }
  ]
}
