{
  "format": "waddle.behavior/v0",
  "name": "agent_invite_wrong_actor_denied",
  "description": "Pins FSM.md C8: an agent-invited episode admits ACTOR_KIND_AGENT claims only — a TELEOPERATOR claim_granted in RUNNING is rejected AND the refusal is recorded as ClaimEvent{DENIED} (the plane already sent GRANT, so the SDK's refusal goes on the timeline; no ClaimEvent{GRANTED}, no active claim, episode unaffected, the invite stays open); a subsequent AGENT grant (the invited actor) is then admitted normally, showing the guard is actor-specific rather than a blanket rejection.",
  "target": "fsm",
  "requires_features": ["waddle.v0.core", "waddle.v0.agent"],
  "setup": {
    "lease_enforcement": "LEASE_ENFORCEMENT_ENFORCED",
    "handoff": { "immediate": { "blendNs": "0" } },
    "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING"
  },
  "steps": [
    { "inject": { "kind": "episode_open", "episode_id": "ep-awa-0001", "verification_mode": "RESET_VERIFICATION_MODE_BLOCKING", "agent_invite": { "prompt": "wipe down the counter", "timeout_ns": "10000000000" } } },
    { "advance_ns": "100000000" },
    { "inject": { "kind": "reset_result", "result": { "ok": true, "strategy": "scripted_home", "verification": { "mode": "RESET_VERIFICATION_MODE_BLOCKING", "verified": true, "judgeId": "judge-reset", "judgeVersion": "2.1.0", "score": 0.95, "tNs": "100000000" } } } },
    { "inject": { "kind": "start" } },
    { "expect_state": { "episode.state": "EPISODE_STATE_RUNNING", "episode.agent_invited": true } },

    { "inject": { "kind": "claim_granted", "claim": { "claimId": "claim-awa-wrong", "episodeId": "ep-awa-0001", "actor": { "kind": "ACTOR_KIND_TELEOPERATOR", "id": "top-7", "displayName": "Teleoperator 7" }, "sourceName": "teleop", "selfInitiated": false } } },
    { "expect_emission": { "event": { "claim": { "kind": "CLAIM_EVENT_KIND_DENIED", "claim": { "claimId": "claim-awa-wrong" } } }, "within_ns": "0" } },
    { "expect_no_emission": { "event": { "claim": { "kind": "CLAIM_EVENT_KIND_GRANTED" } }, "within_ns": "0" } },
    { "expect_state": { "claim.active_claim_id": "", "episode.state": "EPISODE_STATE_RUNNING", "episode.agent_engaged": false } },

    { "inject": { "kind": "claim_granted", "claim": { "claimId": "claim-awa-right", "episodeId": "ep-awa-0001", "actor": { "kind": "ACTOR_KIND_AGENT", "id": "agent-waddle-1", "displayName": "Waddle agent" }, "sourceName": "waddle-agent", "selfInitiated": false } } },
    { "expect_emission": { "event": { "claim": { "kind": "CLAIM_EVENT_KIND_GRANTED" } }, "within_ns": "0" } },
    { "expect_state": { "claim.active_claim_id": "claim-awa-right" } }
  ]
}
