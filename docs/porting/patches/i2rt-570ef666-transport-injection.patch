+"""Injected transports preserve motor transactions and resource ownership.
+
+Every bus below is a double. Tests never connect to real hardware.
+"""
+
+from collections import deque
+from types import SimpleNamespace
+from typing import Any, NoReturn
+
+import can
+import numpy as np
+import pytest
+
+from i2rt.motor_drivers.can_interface import CanInterface
+from i2rt.motor_drivers.dm_driver import ControlMode, DMChainCanInterface, DMSingleMotorCanInterface
+from i2rt.motor_drivers.utils import MotorType
+from i2rt.robots import get_robot
+from i2rt.robots.utils import ArmType
+
+
+class Bus:
+    state = can.BusState.ACTIVE
+
+    def __init__(self, *, channel: str, **kwargs: Any):
+        self.channel_info = channel
+        self.options = kwargs
+        self.sent, self.replies = [], deque()
+        self.shutdown_count = 0
+
+    def send(self, message: can.Message) -> None:
+        self.sent.append(message)
+        self.replies.append(
+            can.Message(
+                arbitration_id=message.arbitration_id + 16,
+                data=[0x10 | message.arbitration_id, 0x80, 0, 0x80, 0, 0, 25, 26],
+                is_extended_id=False,
+            )
+        )
+
+    def recv(self, timeout: float | None = None) -> can.Message | None:
+        return self.replies.popleft() if self.replies else None
+
+    def shutdown(self) -> None:
+        self.shutdown_count += 1
+
+
+def test_injected_instances_preserve_motor_protocol_and_close_independently() -> None:
+    buses = []
+
+    def factory(**kwargs: Any) -> Bus:
+        bus = Bus(**kwargs)
+        buses.append(bus)
+        return bus
+
+    left = DMSingleMotorCanInterface(channel="usb-left", bus_factory=factory)
+    right = DMSingleMotorCanInterface(channel="usb-right", bus_factory=factory)
+    feedback = left.motor_on(1, MotorType.DM4310)
+    assert feedback.id == 1 and feedback.error_code == "0x1"
+    assert buses[0].sent[0].arbitration_id == 1
+    assert bytes(buses[0].sent[0].data) == b"\xff" * 7 + b"\xfc"
+    assert buses[1].sent == []
+    left.close()
+    left.close()
+    assert buses[0].shutdown_count == 1 and buses[1].shutdown_count == 0
+    assert right.motor_on(2, MotorType.DM4310).id == 2
+    right.close()
+    assert buses[1].shutdown_count == 1
+
+
+def test_original_socketcan_selection_is_preserved(monkeypatch: pytest.MonkeyPatch) -> None:
+    opened = []
+
+    def factory(**kwargs: Any) -> Bus:
+        opened.append(kwargs)
+        return Bus(**kwargs)
+
+    monkeypatch.setattr(can.interface, "Bus", factory)
+    interface = DMSingleMotorCanInterface(channel="can7")
+    try:
+        assert opened == [{"bustype": "socketcan", "channel": "can7", "bitrate": 1_000_000}]
+        assert interface.motor_on(1, MotorType.DM4310).id == 1
+    finally:
+        interface.close()
+
+
+def test_invalid_motor_mode_is_refused_before_opening_a_bus() -> None:
+    def forbidden(**kwargs: Any) -> NoReturn:
+        pytest.fail("Invalid motor mode opened a bus")
+
+    with pytest.raises(ValueError, match="Control mode"):
+        DMSingleMotorCanInterface(control_mode="invalid", bus_factory=forbidden)
+
+
+def test_partial_open_closes_the_bus_and_preserves_the_original_failure() -> None:
+    original = RuntimeError("device feedback is invalid")
+    cleanup = OSError(5, "USB release failed")
+
+    class FaultBus(Bus):
+        @property
+        def state(self) -> NoReturn:
+            raise original
+
+        def shutdown(self) -> NoReturn:
+            super().shutdown()
+            raise cleanup
+
+    bus = FaultBus(channel="usb-one")
+    with pytest.raises(RuntimeError) as caught:
+        CanInterface(bus_factory=lambda **kwargs: bus)
+    assert caught.value is original
+    assert bus.shutdown_count == 1
+    assert original.can_cleanup_error == {"type": "OSError", "detail": str(cleanup), "errno": 5}
+
+
+def test_notifier_failure_still_shuts_down_its_owned_bus(monkeypatch: pytest.MonkeyPatch) -> None:
+    original = RuntimeError("notifier drain failed")
+
+    class Notifier:
+        def __init__(self, bus: Bus, listeners: list[can.Listener]):
+            self.bus = bus
+
+        def stop(self) -> NoReturn:
+            raise original
+
+    monkeypatch.setattr(can, "Notifier", Notifier)
+    bus = Bus(channel="buffered")
+    interface = CanInterface(bus_factory=lambda **kwargs: bus, use_buffered_reader=True)
+    with pytest.raises(RuntimeError) as caught:
+        interface.close()
+    assert caught.value is original and bus.shutdown_count == 1
+
+
+def test_robot_factory_passes_one_per_chain_transport_without_changing_gains(monkeypatch: pytest.MonkeyPatch) -> None:
+    buses, arguments = [], []
+
+    def factory(**kwargs: Any) -> DMSingleMotorCanInterface:
+        arguments.append(kwargs.copy())
+
+        def bus_factory(**bus_kwargs: Any) -> Bus:
+            bus = Bus(**bus_kwargs)
+            buses.append(bus)
+            return bus
+
+        return DMSingleMotorCanInterface(bus_factory=bus_factory, **kwargs)
+
+    def forbidden(**kwargs: Any) -> NoReturn:
+        pytest.fail("Injected transport fell through to the global CAN factory")
+
+    monkeypatch.setattr(can.interface, "Bus", forbidden)
+    monkeypatch.setattr(DMChainCanInterface, "start_thread", lambda self: None)
+    monkeypatch.setattr(get_robot, "MotorChainRobot", SimpleNamespace)
+    robot = get_robot.get_yam_robot(
+        channel="usb-selected", gripper_limits_override=np.array([0.0, 1.0]), motor_interface_factory=factory
+    )
+    try:
+        assert arguments == [
+            {
+                "channel": "usb-selected",
+                "bitrate": 1_000_000,
+                "receive_mode": get_robot.ReceiveMode.p16,
+                "name": "yam_real",
+                "control_mode": ControlMode.MIT,
+                "use_buffered_reader": False,
+            }
+        ]
+        assert len(buses) == 1 and len(buses[0].sent) == 7
+        hw = get_robot._load_arm_config(ArmType.YAM)
+        np.testing.assert_array_equal(robot.kp[:6], hw.kp)
+        np.testing.assert_array_equal(robot.kd[:6], hw.kd)
+        assert robot.gripper_index == 6
+    finally:
+        robot.motor_chain.close()
+    assert buses[0].shutdown_count == 1
+
+
+@pytest.mark.parametrize("arm_type", [ArmType.YAM, ArmType.NO_ARM])
+def test_simulation_factory_never_opens_the_injected_transport(arm_type: ArmType) -> None:
+    def forbidden(**kwargs: Any) -> NoReturn:
+        pytest.fail("Simulation opened a motor interface")
+
+    robot = get_robot.get_yam_robot(arm_type=arm_type, sim=True, motor_interface_factory=forbidden)
+    try:
+        assert robot.num_dofs() == (7 if arm_type == ArmType.YAM else 1)
+    finally:
+        robot.close()
