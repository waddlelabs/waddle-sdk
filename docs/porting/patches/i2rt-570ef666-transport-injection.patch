+"""Control-loop readiness, original faults and drain; no devices are opened."""
+
+import threading
+from typing import Any, NoReturn
+
+import pytest
+
+from i2rt.utils.control_loop import ControlLoopTimeout, ManagedControlLoop
+
+
+def test_ready_means_a_completed_iteration_and_stop_wakes_the_selected_loop() -> None:
+    entered, complete, stopped = threading.Event(), threading.Event(), threading.Event()
+    loop = ManagedControlLoop(name="test-control", period_s=0.004)
+
+    def run() -> None:
+        entered.set()
+        assert complete.wait(2)
+        loop.mark_ready()
+        loop.wait(100)
+        stopped.set()
+
+    startup = threading.Thread(target=loop.start, args=(run,))
+    startup.start()
+    assert entered.wait(2)
+    assert startup.is_alive() and not loop.ready.is_set()
+    complete.set()
+    startup.join(2)
+    assert not startup.is_alive()
+    loop.stop()
+    loop.stop()
+    assert stopped.is_set() and not loop.thread.is_alive()
+
+
+@pytest.mark.parametrize("ready_first", [False, True])
+def test_original_fault_is_retained_before_and_after_readiness(ready_first: bool) -> None:
+    original = OSError(5, "selected USB endpoint disconnected")
+    fail = threading.Event()
+    loop = ManagedControlLoop(name="test-control", period_s=0.004)
+
+    def run() -> NoReturn:
+        if ready_first:
+            loop.mark_ready()
+            assert fail.wait(2)
+        raise original
+
+    if ready_first:
+        loop.start(run)
+        fail.set()
+        loop.thread.join(2)
+    else:
+        with pytest.raises(OSError) as caught:
+            loop.start(run)
+        assert caught.value is original
+    assert loop.ready.is_set() is ready_first and loop.fault is original
+    with pytest.raises(OSError) as caught:
+        loop.raise_if_failed()
+    assert caught.value is original
+    loop.stop()
+    with pytest.raises(OSError) as caught:
+        loop.start(run)
+    assert caught.value is original
+
+
+def test_a_blocked_writer_retains_its_thread_until_drain_is_confirmed() -> None:
+    blocked, release = threading.Event(), threading.Event()
+    loop = ManagedControlLoop(name="blocked-writer", period_s=0.004, drain_timeout_s=0.01)
+
+    def run() -> None:
+        loop.mark_ready()
+        blocked.set()
+        assert release.wait(2)
+
+    loop.start(run)
+    assert blocked.is_set()
+    try:
+        with pytest.raises(ControlLoopTimeout) as caught:
+            loop.stop()
+        assert loop.thread.is_alive()
+        assert caught.value.as_dict()["context"] == {
+            "loop": "blocked-writer",
+            "operation": "drain",
+            "timeout_s": 0.01,
+        }
+    finally:
+        release.set()
+        loop.stop()
+    assert not loop.thread.is_alive()
+
+
+def test_startup_timeout_preserves_original_and_uncertain_cleanup() -> None:
+    release = threading.Event()
+    loop = ManagedControlLoop(
+        name="blocked-start",
+        period_s=0.004,
+        startup_timeout_s=0.01,
+        drain_timeout_s=0.01,
+    )
+
+    def run() -> None:
+        assert release.wait(2)
+
+    try:
+        with pytest.raises(ControlLoopTimeout) as caught:
+            loop.start(run)
+        assert caught.value.operation == "startup"
+        assert caught.value.control_cleanup_error["context"]["operation"] == "drain"
+        assert loop.thread.is_alive()
+    finally:
+        release.set()
+        loop.stop()
+
+
+def test_injected_wait_receives_stop_and_exact_timing_and_preserves_its_fault() -> None:
+    original = OSError("native scheduler refused the calling-thread policy")
+    calls = []
+    loop: ManagedControlLoop
+
+    def wait(stop: threading.Event, timeout_s: float, *, period_s: float) -> NoReturn:
+        calls.append((stop, timeout_s, period_s))
+        raise original
+
+    loop = ManagedControlLoop(name="scheduled", period_s=0.004, wait_callback=wait)
