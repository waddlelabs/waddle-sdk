--- /dev/null
+++ b/i2rt/utils/control_loop.py
@@ -0,0 +1,113 @@
+"""Device-free lifecycle and optional host wait policy for control threads."""
+
+import logging
+import math
+import threading
+from typing import Callable, Protocol
+
+
+class LoopWait(Protocol):
+    def __call__(self, stop: threading.Event, timeout_s: float, *, period_s: float) -> bool: ...
+
+
+class ControlLoopTimeout(TimeoutError):
+    code = "runtime.control_loop_timeout"
+
+    def __init__(self, name: str, operation: str, timeout_s: float) -> None:
+        self.name, self.operation, self.timeout_s = name, operation, timeout_s
+        super().__init__(f"{name}: control-loop {operation} did not finish within {timeout_s:g} s")
+        self.control_cleanup_error: dict | None = None
+
+    def as_dict(self) -> dict:
+        return {
+            "code": self.code,
+            "detail": str(self),
+            "context": {"loop": self.name, "operation": self.operation, "timeout_s": self.timeout_s},
+        }
+
+
+class ManagedControlLoop:
+    """Retain one thread, its first fault and explicit first-iteration readiness.
+
+    The optional callback owns only the blocking wait. It must preserve stop
+    wakeups and propagate its original errors. No policy surrounds computation,
+    CAN I/O or logging. Neither a scheduling request nor readiness proves device
+    timing or physical arrival. Failed drain keeps the retained thread accessible.
+    """
+
+    def __init__(
+        self,
+        *,
+        name: str,
+        period_s: float,
+        wait_callback: LoopWait | None = None,
+        startup_timeout_s: float = 5.0,
+        drain_timeout_s: float = 1.0,
+    ) -> None:
+        for value in (period_s, startup_timeout_s, drain_timeout_s):
+            if type(value) not in (int, float) or not math.isfinite(value) or value <= 0:
+                raise ValueError("Declare finite positive control-loop timing budgets")
+        self.name, self.period_s = name, period_s
+        self.wait_callback = wait_callback
+        self.startup_timeout_s, self.drain_timeout_s = startup_timeout_s, drain_timeout_s
+        self.stop_event, self.ready = threading.Event(), threading.Event()
+        self._startup_finished = threading.Event()
+        self.fault: BaseException | None = None
+        self.thread: threading.Thread | None = None
+
+    def _run(self, target: Callable[[], None]) -> None:
+        try:
+            target()
+        except BaseException as error:
+            self.fault = error
+            logging.exception("%s: control loop failed", self.name)
+        finally:
+            self.stop_event.set()
+            # Wake a startup waiter on failure or premature completion as well.
+            self._startup_finished.set()
+
+    def start(self, target: Callable[[], None]) -> None:
+        self.raise_if_failed()
+        if self.stop_event.is_set():
+            raise RuntimeError(f"{self.name}: a stopped control loop cannot be restarted")
+        if self.thread is not None:
+            if self.thread.is_alive() and not self.stop_event.is_set():
+                return
+            raise RuntimeError(f"{self.name}: a stopped control loop cannot be restarted")
+        self.thread = threading.Thread(target=self._run, args=(target,), name=self.name)
+        self.thread.start()
+        if not self._startup_finished.wait(self.startup_timeout_s):
+            error = ControlLoopTimeout(self.name, "startup", self.startup_timeout_s)
+            try:
+                self.stop()
+            except ControlLoopTimeout as cleanup:
+                error.control_cleanup_error = cleanup.as_dict()
+            raise error
+        self.raise_if_failed()
+        if self.stop_event.is_set():
+            raise RuntimeError(f"{self.name}: control loop stopped during startup")
+
+    def mark_ready(self) -> None:
+        self.ready.set()
+        self._startup_finished.set()
+
+    def raise_if_failed(self) -> None:
+        if self.fault is not None:
+            raise self.fault
+
+    def wait(self, timeout_s: float) -> bool:
+        if self.stop_event.is_set():
+            return True
+        if self.wait_callback is None:
+            return self.stop_event.wait(timeout_s)
+        return self.wait_callback(self.stop_event, timeout_s, period_s=self.period_s)
+
+    def stop(self) -> None:
+        self.stop_event.set()
+        if self.thread is None:
+            return
+        if self.thread is threading.current_thread():
+            raise RuntimeError(f"{self.name}: a control thread cannot join itself")
+        self.thread.join(self.drain_timeout_s)
+        if self.thread.is_alive():
+            raise ControlLoopTimeout(self.name, "drain", self.drain_timeout_s)
