+"""Actual chain/server lifecycle with transport doubles; no hardware access."""
+
+import threading
+from types import SimpleNamespace
+from typing import Any, NoReturn
+
+import numpy as np
+import pytest
+
+from i2rt.motor_drivers.dm_driver import DMChainCanInterface
+from i2rt.motor_drivers.utils import MotorType
+from i2rt.robots import get_robot
+from i2rt.robots.motor_chain_robot import MotorChainRobot
+from i2rt.utils.control_loop import ControlLoopTimeout
+
+
+class MotorInterface:
+    def __init__(self) -> None:
+        self.commands: list[dict] = []
+        self.closed = 0
+        self.fault: BaseException | None = None
+
+    def _drain_bus(self, **kwargs: Any) -> int:
+        return 0
+
+    def motor_on(self, motor_id: int, motor_type: str) -> SimpleNamespace:
+        return SimpleNamespace(
+            id=motor_id,
+            error_code="0x1",
+            position=0.0,
+            velocity=0.0,
+            torque=0.0,
+            temperature_mos=25.0,
+            temperature_rotor=26.0,
+        )
+
+    def set_control(self, **kwargs: Any) -> SimpleNamespace:
+        if self.fault is not None:
+            raise self.fault
+        self.commands.append(kwargs.copy())
+        return self.motor_on(kwargs["motor_id"], kwargs["motor_type"])
+
+    def close(self) -> None:
+        self.closed += 1
+
+
+def chain(interface: MotorInterface, **kwargs: Any) -> DMChainCanInterface:
+    return DMChainCanInterface(
+        [[1, MotorType.DM4310]],
+        np.array([0.0]),
+        np.array([1.0]),
+        channel="selected-usb",
+        motor_interface_factory=lambda **options: interface,
+        **kwargs,
+    )
+
+
+def test_chain_close_drains_before_release_and_preserves_motor_command_values() -> None:
+    interface = MotorInterface()
+    waiting = threading.Event()
+    calls = []
+
+    def wait(stop: threading.Event, timeout_s: float, *, period_s: float) -> bool:
+        calls.append((timeout_s, period_s))
+        waiting.set()
+        return stop.wait(100)
+
+    instance = chain(interface, control_wait=wait)
+    assert waiting.wait(2)
+    thread = instance._control_loop.thread
+    instance.close()
+    assert thread is not None and not thread.is_alive()
+    assert interface.closed == 1 and calls == [(0.0005, 0.004)]
+    with pytest.raises(RuntimeError, match="stopped control loop"):
+        instance.start_thread()
+    assert interface.commands == [
+        {
+            "motor_id": 1,
+            "motor_type": MotorType.DM4310,
+            "pos": 0.0,
+            "vel": 0.0,
+            "kp": 0.0,
+            "kd": 0.0,
+            "torque": 0.0,
+        }
+    ]
+
+
+def test_chain_unknown_drain_retains_bus_until_the_writer_actually_exits() -> None:
+    interface = MotorInterface()
+    blocked, release = threading.Event(), threading.Event()
+
+    def wait(stop: threading.Event, timeout_s: float, *, period_s: float) -> bool:
+        blocked.set()
+        assert release.wait(2)
+        return stop.is_set()
+
+    instance = chain(interface, control_wait=wait)
+    instance._control_loop.drain_timeout_s = 0.01
+    assert blocked.wait(2)
+    try:
+        with pytest.raises(ControlLoopTimeout):
+            instance.close()
+        assert interface.closed == 0 and instance._control_loop.thread.is_alive()
+    finally:
+        release.set()
+        instance.close()
+    assert interface.closed == 1
+
+
+def test_chain_startup_fault_closes_owned_transport_and_retains_the_original() -> None:
+    interface = MotorInterface()
+    original = OSError(5, "selected device rejected the first command")
+    interface.fault = original
+    with pytest.raises(OSError) as caught:
+        chain(interface)
+    assert caught.value is original and interface.closed == 1
+
