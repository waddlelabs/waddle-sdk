+def test_robot_factory_failure_closes_the_started_chain(monkeypatch: pytest.MonkeyPatch) -> None:
+    interface = MotorInterface()
+    original = ValueError("joint state does not fit the selected model")
+    retained = []
+
+    def refuse(**kwargs: Any) -> NoReturn:
+        retained.append(kwargs["motor_chain"])
+        raise original
+
+    monkeypatch.setattr(get_robot, "MotorChainRobot", refuse)
+    try:
+        with pytest.raises(ValueError) as caught:
+            get_robot.get_yam_robot(
+                channel="selected-usb",
+                gripper_limits_override=np.array([0.0, 1.0]),
+                motor_interface_factory=lambda **kwargs: interface,
+            )
+        assert caught.value is original and interface.closed == 1
+        assert not retained[0]._control_loop.thread.is_alive()
+    finally:
+        for instance in retained:
+            instance.stop_control_loop()
+
+
+def test_server_wait_fault_reaches_observations_and_commands_with_exact_identity() -> None:
+    interface = MotorInterface()
+    instance = chain(interface)
+    entered, fail = threading.Event(), threading.Event()
+    original = OSError(5, "calling-thread policy could not be restored")
+
+    def wait(stop: threading.Event, timeout_s: float, *, period_s: float) -> NoReturn:
+        assert timeout_s == period_s == 0.001
+        entered.set()
+        assert fail.wait(2)
+        raise original
+
+    robot = MotorChainRobot(
+        instance,
+        use_gravity_comp=False,
+        joint_limits=np.array([[-1.0, 1.0]]),
+        control_wait=wait,
+    )
+    try:
+        assert entered.wait(2)
+        fail.set()
+        robot._server_thread.join(2)
+        assert robot.control_fault is original
+        for operation in (
+            robot.get_joint_pos,
+            robot.get_observations,
+            lambda: robot.command_joint_pos(np.array([0.1])),
+            lambda: robot.command_joint_state({"pos": np.array([0.1]), "vel": np.array([0.0])}),
+        ):
+            with pytest.raises(OSError) as caught:
+                operation()
+            assert caught.value is original
+    finally:
+        fail.set()
+        robot.close()
+    assert interface.closed == 1 and not instance._control_loop.thread.is_alive()
